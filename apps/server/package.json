{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@ShopOS-Platform/api": "workspace:*",
    "@ShopOS-Platform/db": "workspace:*",
    "@ShopOS-Platform/env": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@ts-rest/core": "catalog:",
    "@ts-rest/serverless": "^3.52.1",
    "bullmq": "^5.81.2",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ShopOS-Platform/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "^5.0.6",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
  }
}
